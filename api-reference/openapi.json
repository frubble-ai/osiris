        "tags": [
          "auth-configs"
        ],
        "summary": "The providers' apps, in batches.",
        "operationId": "list_auth_configs",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "A batch's `next_cursor`: the batch after it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "A batch's `previous_cursor`: the batch before it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many items a batch holds, within the server's bounds.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
