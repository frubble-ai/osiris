  "components": {
    "schemas": {
      "ActionResult_Vec_GithubInstallation": {
        "type": "object",
        "description": "An action's answer: what it read, as `data`.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Where our GitHub App is installed: an account or organization.",
              "required": [
                "id",
                "account",
                "account_type",
                "repository_selection"
              ],
              "properties": {
                "account": {
                  "type": "string",
                  "description": "The account or organization's login."
                },
                "account_type": {
                  "$ref": "#/components/schemas/GithubAccountType"
                },
                "id": {
                  "type": "string"
                },
                "repository_selection": {
                  "$ref": "#/components/schemas/GithubRepositorySelection"
                }
              }
            }
          }
        }
      },
      "ActionResult_Vec_GithubRepository": {
        "type": "object",
        "description": "An action's answer: what it read, as `data`.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A repository our GitHub App reads, through one of its installations.",
              "required": [
                "id",
                "full_name",
                "private",
                "url"
              ],
              "properties": {
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "full_name": {
                  "type": "string",
                  "description": "`owner/name`."
                },
                "id": {
                  "type": "string"
                },
                "private": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ActionResult_Vec_LinearTeam": {
        "type": "object",
        "description": "An action's answer: what it read, as `data`.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A Linear team the connected user can see.",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ActionResult_Vec_SlackChannel": {
        "type": "object",
        "description": "An action's answer: what it read, as `data`.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A channel the connected user can see.",
              "required": [
                "id",
                "name",
                "is_private"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "is_private": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "num_members": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int64",
