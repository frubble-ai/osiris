{
  "db_name": "PostgreSQL",
  "query": "SELECT id, auth_config_id, provider, user_id, alias, status, credential_kind, installation_id, callback_url, access_token, refresh_token, access_token_expires_at, refresh_token_issued_at, scope, last_refresh_error, refresh_failures, token_generation, refresh_task, refresh_task_at, created_at, updated_at FROM connected_account\n             WHERE ($1::text IS NULL OR user_id = $1)\n               AND ($2::text IS NULL OR provider = $2)\n               AND ($3::text IS NULL OR auth_config_id = $3)\n               AND ($4::text IS NULL OR alias = $4)\n               AND ($5::text IS NULL OR status = $5)\n               AND ($6::text IS NULL OR (created_at, id) > (SELECT created_at, id FROM connected_account WHERE id = $6))\n             ORDER BY created_at ASC, id ASC\n             LIMIT $7",
