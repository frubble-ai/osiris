  "query": "SELECT id, provider, client_id, client_secret, scopes, settings, secret_settings, created_at, updated_at FROM auth_config\n             WHERE ($1::text IS NULL OR (created_at, id) > (SELECT created_at, id FROM auth_config WHERE id = $1))\n             ORDER BY created_at ASC, id ASC\n             LIMIT $2",
