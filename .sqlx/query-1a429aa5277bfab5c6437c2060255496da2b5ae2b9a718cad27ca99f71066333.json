{
  "db_name": "PostgreSQL",
  "query": "SELECT id, connected_account_id, provider, kind, config, secret, status, subscription_id, checkpoint, last_error, poll_task, poll_task_at, created_at, updated_at FROM trigger\n             WHERE ($1::text IS NULL OR connected_account_id = $1)\n               AND (created_at, id) < (SELECT created_at, id FROM trigger WHERE id = $2)\n             ORDER BY created_at DESC, id DESC\n             LIMIT $3",
