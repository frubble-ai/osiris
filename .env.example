# Copy to .env (git-ignored). `just` reads it, and so does osiris when started from this
# directory. The variables are the same ones the platform sets when deployed.

# The database, over TLS with verify-ca, as on Cloud SQL. Values match docker-compose.yml.
# DB_CA_PEM (the CA certificate itself, in PEM) is exported by the justfile from the CA that
# `just up` generates in .local/tls. To run osiris outside `just`:
#   export DB_CA_PEM="$(cat .local/tls/ca.pem)"
DB_HOST=localhost
DB_PORT=5433
DB_NAME=osiris
DB_USER=osiris
DB_PASSWORD=osiris_dev
# Builds use the committed .sqlx/ instead of asking the database (`just sqlx-prepare` refreshes it).
SQLX_OFFLINE=true

# Which ports `just dev` gives each process as PORT.
API_PORT=8090
WORKER_PORT=8091

RUST_LOG=info,osiris_server=debug
OSIRIS_PUBLIC_URL=http://localhost:8090
# Local-only values; deployed ones come from Secret Manager. Each at least 32 characters.
OSIRIS_API_KEY=local-api-key-0123456789abcdefghijklmnop
OSIRIS_ADMIN_KEY=local-admin-key-0123456789abcdefghijklmn
OSIRIS_ENCRYPTION_KEY=local-encryption-key-0123456789abcdefghij
# Events: the Pub/Sub emulator from docker-compose locally; when deployed, the topic is infrastructure.
PUBSUB_EMULATOR_HOST=localhost:8086
PUBSUB_PROJECT=osiris-local
OSIRIS_EVENTS_TOPIC=osiris-events
# Where the emulator pushes events, when the app's worker runs locally (empty: nowhere).
OSIRIS_EVENTS_PUSH_ENDPOINT=
# Scheduled tasks: locally, timers inside osiris send each task to the worker when it is due.
# When deployed, OSIRIS_TASKS=cloud_tasks and the CLOUD_TASKS_* variables (docs/configuration.md).
OSIRIS_TASKS=local
OSIRIS_WORKER_URL=http://localhost:8091
# The bearer token the local scheduler sends and the worker checks.
OSIRIS_WORKER_TOKEN=local-worker-token-0123456789abcdefgh
